{
  "DESIGN_NAME": "rf_wrapper",
  "FP_PDN_MULTILAYER": false,
  "VERILOG_FILES": [
    "dir::../../macro/rf_top.v",
    "dir::../../macro/rf_wrapper.v"
  ],
  "CLOCK_PERIOD": 25,
  "CLOCK_PORT": "clk",
  "FP_SIZING": "absolute",
  "DIE_AREA": [
    0,
    0,
    200,
    220
  ],
  "MACROS": {
    "rf_top": {
      "instances": {
        "i_rf": {
          "location": [10.1, 30],
          "orientation": "W"
        }
      },
      "gds": ["dir::../../macro/rf_top.gds"],
      "lef": ["dir::../../macro/rf_top.lef"],
      "lib": {
        "*": ["dir::../../macro/rf_top.lib"]
      }
    }
  },
  "PDN_MACRO_CONNECTIONS": [
    "i_rf vccd1 vssd1 VDPWR VGND"
  ],
  "VDD_NETS": ["vccd1"],
  "GND_NETS": ["vssd1"],
  "FP_PDN_HPITCH": 20,
  "FP_PDN_VPITCH": 20,
  "FP_PDN_HORIZONTAL_LAYER": "met3",
  "RT_MAX_LAYER": "met4",
  "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",

  "GRT_ALLOW_CONGESTION": 1,

  "RUN_HEURISTIC_DIODE_INSERTION": true,
  "HEURISTIC_ANTENNA_THRESHOLD": 110,
  "RUN_ANTENNA_REPAIR": true,
  "RUN_POST_GRT_DESIGN_REPAIR": true,
  "RUN_POST_GRT_RESIZER_TIMING": true,
  "GRT_ANTENNA_ITERS": 20,
  "GRT_ANTENNA_MARGIN": 15,
  "DESIGN_REPAIR_MAX_SLEW_PCT": 30,
  "DESIGN_REPAIR_MAX_CAP_PCT": 30,
  "DIODE_ON_PORTS": "both",
  "ERROR_ON_KLAYOUT_DRC": false,
  "ERROR_ON_XOR_ERROR": false,
  "MAGIC_DEF_LABELS": false

}
